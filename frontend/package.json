{
  "name": "ri360-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "cd ../backend && python data_pipeline/build_site_data.py",
    "build:mobile": "tsc --noEmit && vite build --mode mobile",
    "cap:sync": "npm run build:mobile && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "app:assets": "node scripts/app-assets.cjs && capacitor-assets generate --android --ios --iconBackgroundColor \"#d7261e\" --iconBackgroundColorDark \"#d7261e\" --splashBackgroundColor \"#f7f3ea\" --splashBackgroundColorDark \"#12100d\""
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.6.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.2",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.6.3",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
